# Local defaults; scripts/init_env.py replaces local-only credentials safely.
DATABASE_URL=postgresql+psycopg://paisa:paisa@127.0.0.1:54329/paisa_dev
TEST_DATABASE_URL=postgresql+psycopg://paisa:paisa@127.0.0.1:54329/paisa_test
POSTGRES_PASSWORD=paisa
JWT_SECRET=generate-me-with-scripts-init_env
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY= # paste your key here; leave empty to use the built-in mock AI
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=200
ATTACHMENT_DIR=./var/attachments
ATTACHMENT_QUOTA_BYTES=104857600
SYNC_TOMBSTONE_DAYS=90
