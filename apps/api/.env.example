# Local defaults; scripts/init_env.py replaces local-only credentials safely.
DATABASE_URL=postgresql+psycopg://paisa:paisa@127.0.0.1:54329/paisa_dev
# Neon env pull also writes DATABASE_URL_UNPOOLED; Alembic uses it automatically.
# Optional explicit Alembic URL override (direct/unpooled for Neon).
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgresql+psycopg://paisa:paisa@127.0.0.1:54329/paisa_test
POSTGRES_PASSWORD=paisa
JWT_SECRET=generate-me-with-scripts-init_env
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_PROVIDER=muse
MODEL_API_KEY= # paste your Meta Model API key here; leave empty to use the built-in mock AI
MODEL_API_BASE_URL=https://api.meta.ai
AI_MODEL_FAST=muse-spark-1.3
AI_MODEL_SMART=muse-spark-1.3
# Optional Anthropic alternative: AI_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=200
ATTACHMENT_DIR=./var/attachments
ATTACHMENT_QUOTA_BYTES=104857600
SYNC_TOMBSTONE_DAYS=90
